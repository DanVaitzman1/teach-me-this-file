<mxfile host="app.diagrams.net" agent="Teach Me This File docs" version="24.0.0"><diagram id="arch" name="1 · Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arch-1" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Teach Me This File&lt;/b&gt;&lt;/font&gt; — architecture&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#666&quot;&gt;React SPA ⇄ stateless Express service on Render ⇄ Google Gemini · arrows show requests, labels show what travels&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="60" as="geometry"/></mxCell><mxCell id="arch-2" value="Browser · React 19 + Vite + Tailwind (client/src)" style="swimlane;rounded=1;arcSize=2;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="640" height="1000" as="geometry"/></mxCell><mxCell id="arch-3" value="UI — features/ + components/ (render only)" style="swimlane;rounded=1;arcSize=3;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fontSize=12;fillColor=#eef4fd;strokeColor=#6c8ebf;" vertex="1" parent="arch-2"><mxGeometry x="20" y="45" width="600" height="360" as="geometry"/></mxCell><mxCell id="arch-4" value="&lt;b&gt;App.jsx&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;picks the screen from lesson.status: idle → Upload · planning / plan_error → Planning · ready / finished → Lesson&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-3"><mxGeometry x="15" y="40" width="570" height="50" as="geometry"/></mxCell><mxCell id="arch-5" value="&lt;b&gt;UploadScreen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;file picker (drag &amp;amp; drop, 10 MB) + teacher prompt · Cancel · dev-only sample&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-3"><mxGeometry x="15" y="105" width="180" height="85" as="geometry"/></mxCell><mxCell id="arch-6" value="&lt;b&gt;PlanningScreen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&quot;Preparing your lesson…&quot; + elapsed time · Try again / Back&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-3"><mxGeometry x="210" y="105" width="180" height="85" as="geometry"/></mxCell><mxCell id="arch-7" value="&lt;b&gt;LessonScreen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;LessonProgress &quot;Step N of M&quot; · StepList · dir/lang from the plan (RTL mirrors)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-3"><mxGeometry x="405" y="105" width="180" height="85" as="geometry"/></mxCell><mxCell id="arch-8" value="&lt;b&gt;ChatPanel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Message (Markdown + KaTeX) · Composer: Send ↔ Stop · step dividers · &quot;Lesson complete&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-3"><mxGeometry x="15" y="205" width="280" height="70" as="geometry"/></mxCell><mxCell id="arch-9" value="&lt;b&gt;SourceDialog&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&quot;View source&quot; → cited passages, &quot;PDF page N&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-3"><mxGeometry x="305" y="205" width="280" height="70" as="geometry"/></mxCell><mxCell id="arch-10" value="&lt;b&gt;SettingsDialog&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;paste Gemini API key (shared Dialog: bottom sheet on phones)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-3"><mxGeometry x="15" y="285" width="280" height="60" as="geometry"/></mxCell><mxCell id="arch-11" value="&lt;b&gt;ServerStatus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;health check on load → &quot;Waking up the server…&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-3"><mxGeometry x="305" y="285" width="280" height="60" as="geometry"/></mxCell><mxCell id="arch-12" value="Lesson state — lesson/ (no UI, no fetch details)" style="swimlane;rounded=1;arcSize=3;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fontSize=12;fillColor=#eef4fd;strokeColor=#6c8ebf;" vertex="1" parent="arch-2"><mxGeometry x="20" y="425" width="600" height="280" as="geometry"/></mxCell><mxCell id="arch-13" value="&lt;b&gt;useLesson()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;start(file, prompt) → plan request · an effect runs pendingTurn → runTurn() · stop() · retryTurn() · reset()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-12"><mxGeometry x="15" y="40" width="570" height="55" as="geometry"/></mxCell><mxCell id="arch-14" value="&lt;b&gt;lessonReducer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;status · document (passages) · teacherPrompt · &lt;b&gt;plan&lt;/b&gt; · &lt;b&gt;currentStepIndex&lt;/b&gt; · messages[] · &lt;b&gt;pendingTurn&lt;/b&gt; (start_step | reply) · error&lt;br&gt;pure function: the only place progress changes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="arch-12"><mxGeometry x="15" y="110" width="330" height="150" as="geometry"/></mxCell><mxCell id="arch-15" value="&lt;b&gt;turnRequest.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;builds a turn: current step's passages + last 12 messages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-12"><mxGeometry x="360" y="110" width="225" height="70" as="geometry"/></mxCell><mxCell id="arch-16" value="&lt;b&gt;useApiKey()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;key in React state + sessionStorage (this tab only)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-12"><mxGeometry x="360" y="190" width="225" height="70" as="geometry"/></mxCell><mxCell id="arch-17" value="&lt;b&gt;sessionStorage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lesson (ready / finished)&lt;br&gt;gemini-api-key&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="arch-2"><mxGeometry x="20" y="725" width="200" height="110" as="geometry"/></mxCell><mxCell id="arch-18" value="API client — api/" style="swimlane;rounded=1;arcSize=3;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fontSize=12;fillColor=#eef4fd;strokeColor=#6c8ebf;" vertex="1" parent="arch-2"><mxGeometry x="240" y="725" width="380" height="255" as="geometry"/></mxCell><mxCell id="arch-19" value="&lt;b&gt;apiFetch()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/api/* · adds &lt;b&gt;X-Gemini-Key&lt;/b&gt; · non-2xx → ApiError(code, message) · aborts pass through&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-18"><mxGeometry x="15" y="40" width="350" height="60" as="geometry"/></mxCell><mxCell id="arch-20" value="&lt;b&gt;Endpoints&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;getHealth() · uploadDocument() · createPlan() · &lt;b&gt;streamTurn()&lt;/b&gt; — reads SSE: delta → onDelta, meta → done, error → ApiError, cut-off → STREAM_INTERRUPTED&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-18"><mxGeometry x="15" y="115" width="350" height="120" as="geometry"/></mxCell><mxCell id="arch-21" value="Render Web Service (free) · Node.js + Express 5 · stateless — one origin for API and app" style="swimlane;rounded=1;arcSize=2;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;horizontal=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="940" height="1000" as="geometry"/></mxCell><mxCell id="arch-22" value="Middleware (middleware/)" style="swimlane;rounded=1;arcSize=3;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fontSize=12;fillColor=#eef7ec;strokeColor=#82b366;" vertex="1" parent="arch-21"><mxGeometry x="20" y="45" width="900" height="115" as="geometry"/></mxCell><mxCell id="arch-23" value="&lt;b&gt;requestLogger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/api only · request id · one summary line&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-22"><mxGeometry x="15" y="38" width="167" height="65" as="geometry"/></mxCell><mxCell id="arch-24" value="&lt;b&gt;express.json&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;1 MB body limit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-22"><mxGeometry x="192" y="38" width="167" height="65" as="geometry"/></mxCell><mxCell id="arch-25" value="&lt;b&gt;requireApiKey&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;header or GEMINI_API_KEY env · only on req&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-22"><mxGeometry x="369" y="38" width="167" height="65" as="geometry"/></mxCell><mxCell id="arch-26" value="&lt;b&gt;abortOnClose&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;req.abortSignal → cancels Gemini on Stop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-22"><mxGeometry x="546" y="38" width="167" height="65" as="geometry"/></mxCell><mxCell id="arch-27" value="&lt;b&gt;errorHandler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ error: { code, message } } · stack logged&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-22"><mxGeometry x="723" y="38" width="167" height="65" as="geometry"/></mxCell><mxCell id="arch-28" value="Routes (routes/)" style="swimlane;rounded=1;arcSize=3;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fontSize=12;fillColor=#eef7ec;strokeColor=#82b366;" vertex="1" parent="arch-21"><mxGeometry x="20" y="175" width="900" height="125" as="geometry"/></mxCell><mxCell id="arch-29" value="&lt;b&gt;GET /api/health&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ status, hasServerKey }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-28"><mxGeometry x="15" y="38" width="160" height="70" as="geometry"/></mxCell><mxCell id="arch-30" value="&lt;b&gt;POST /api/documents&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;multipart · multer, memory only, 10 MB → { passages[], method, truncated }&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-28"><mxGeometry x="190" y="38" width="230" height="70" as="geometry"/></mxCell><mxCell id="arch-31" value="&lt;b&gt;POST /api/lessons/plan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;zod-validated body → plan JSON&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-28"><mxGeometry x="435" y="38" width="200" height="70" as="geometry"/></mxCell><mxCell id="arch-32" value="&lt;b&gt;POST /api/lessons/turn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;zod body → &lt;b&gt;SSE&lt;/b&gt;: delta… → meta { stepComplete, sourceIds } | error&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-28"><mxGeometry x="650" y="38" width="235" height="70" as="geometry"/></mxCell><mxCell id="arch-33" value="Ingest (ingest/) — file → passages" style="swimlane;rounded=1;arcSize=3;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fontSize=12;fillColor=#eef7ec;strokeColor=#82b366;" vertex="1" parent="arch-21"><mxGeometry x="20" y="315" width="430" height="450" as="geometry"/></mxCell><mxCell id="arch-34" value="&lt;b&gt;extract.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;type by extension · TXT/MD read directly · DOCX → docxToText · image → transcribe · PDF ↓&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-33"><mxGeometry x="15" y="38" width="400" height="60" as="geometry"/></mxCell><mxCell id="arch-35" value="&lt;b&gt;PDF route&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;≤ 20 pages or looks scanned (&amp;lt; 100 chars/page) → AI, max 40 pages · long digital PDF → text layer&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="arch-33"><mxGeometry x="15" y="110" width="400" height="60" as="geometry"/></mxCell><mxCell id="arch-36" value="&lt;b&gt;transcribePdf.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pdf-lib splits into 5-page chunks · 4 in parallel · each chunk + its text layer as a hint · one fails → abort the rest&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-33"><mxGeometry x="15" y="182" width="400" height="70" as="geometry"/></mxCell><mxCell id="arch-37" value="&lt;b&gt;unpdf&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PDF text layer per page&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-33"><mxGeometry x="15" y="264" width="190" height="55" as="geometry"/></mxCell><mxCell id="arch-38" value="&lt;b&gt;docxToText.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;mammoth HTML → Markdown (headings, lists, tables)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-33"><mxGeometry x="225" y="264" width="190" height="55" as="geometry"/></mxCell><mxCell id="arch-39" value="&lt;b&gt;chunk.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;passages ≤ 1200 chars (ids p1…) · split by paragraph → line → sentence · tables cut between rows, header repeated · 200k-char cap → truncated&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-33"><mxGeometry x="15" y="331" width="400" height="95" as="geometry"/></mxCell><mxCell id="arch-40" value="AI (ai/) — everything that talks to Gemini" style="swimlane;rounded=1;arcSize=3;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="arch-21"><mxGeometry x="470" y="315" width="450" height="450" as="geometry"/></mxCell><mxCell id="arch-41" value="&lt;b&gt;gemini.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;model list per task · next model on 404 / 429 / 503 · SDK retries 5xx · waits out a per-minute 429 only on the last model · toAppError → INVALID_API_KEY, RATE_LIMITED, AI_BUSY, AI_ERROR · logs tokens&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-40"><mxGeometry x="15" y="38" width="420" height="95" as="geometry"/></mxCell><mxCell id="arch-42" value="&lt;b&gt;transcribe.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;file inline to Gemini · &quot;=== PAGE n ===&quot; markers (plain text: LaTeX survives) · strips [Note]/[sic]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-40"><mxGeometry x="15" y="145" width="420" height="65" as="geometry"/></mxCell><mxCell id="arch-43" value="&lt;b&gt;plan.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;zod PlanSchema = JSON schema sent to Gemini · drops unknown sourceIds and ungrounded steps · dir from language&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-40"><mxGeometry x="15" y="222" width="420" height="70" as="geometry"/></mxCell><mxCell id="arch-44" value="&lt;b&gt;tutor.js + metaParser.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;system prompt: plan, current step only, teaching rules, teacher prompt can't override · streams text, hides &amp;lt;&amp;lt;&amp;lt;META…&amp;gt;&amp;gt;&amp;gt; · no step completion on a message ending in a question&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-40"><mxGeometry x="15" y="304" width="420" height="125" as="geometry"/></mxCell><mxCell id="arch-45" value="&lt;b&gt;logger.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AsyncLocalStorage request id on every line · pretty in dev, JSON in production · never keys or document text&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-21"><mxGeometry x="20" y="785" width="430" height="75" as="geometry"/></mxCell><mxCell id="arch-46" value="&lt;b&gt;express.static(client/dist) + SPA fallback&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the built React app from the same origin: no CORS, no second host&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-21"><mxGeometry x="470" y="785" width="450" height="75" as="geometry"/></mxCell><mxCell id="arch-47" value="&lt;b&gt;API key rule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the user's key arrives in X-Gemini-Key on every request, lives only on req for that request, is never stored and never logged · GEMINI_API_KEY on the host is optional (not set)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="arch-21"><mxGeometry x="20" y="880" width="900" height="95" as="geometry"/></mxCell><mxCell id="arch-48" value="Google Gemini API (free tier)" style="swimlane;rounded=1;arcSize=2;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=14;horizontal=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1780" y="330" width="330" height="360" as="geometry"/></mxCell><mxCell id="arch-49" value="&lt;b&gt;transcribe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;gemini-3.1-flash-lite → 3.5-flash-lite → 3.6-flash&lt;br&gt;(15/min · 500/day first)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-48"><mxGeometry x="15" y="45" width="300" height="85" as="geometry"/></mxCell><mxCell id="arch-50" value="&lt;b&gt;plan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;gemini-3.8-flash → 3.6-flash → 3.5-flash-lite&lt;br&gt;(strongest first, 1 request per lesson)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-48"><mxGeometry x="15" y="145" width="300" height="85" as="geometry"/></mxCell><mxCell id="arch-51" value="&lt;b&gt;tutor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;gemini-3.5-flash-lite → 3.1-flash-lite → 3.6-flash&lt;br&gt;(fast, high quota: 1 request per message)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="arch-48"><mxGeometry x="15" y="245" width="300" height="95" as="geometry"/></mxCell><mxCell id="arch-52" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DanVaitzman1/teach-me-this-file (public)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1780" y="760" width="330" height="70" as="geometry"/></mxCell><mxCell id="arch-53" value="&lt;b&gt;Render build&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;npm run build (client → dist) · npm start&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1780" y="870" width="330" height="70" as="geometry"/></mxCell><mxCell id="arch-54" value="HTTPS /api/* + X-Gemini-Key&lt;br&gt;multipart · JSON · SSE stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-20" target="arch-28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="990"/><mxPoint x="720" y="327"/></Array></mxGeometry></mxCell><mxCell id="arch-55" value="serves the built SPA (HTML, JS, CSS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-46" target="arch-2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1455" y="1125"/><mxPoint x="360" y="1125"/></Array></mxGeometry></mxCell><mxCell id="arch-56" value="@google/genai&lt;br&gt;with the user's key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-40" target="arch-48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-57" value="push to main → auto deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-52" target="arch-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-58" value="actions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-4" target="arch-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="68" y="200"/><mxPoint x="68" y="582"/></Array></mxGeometry></mxCell><mxCell id="arch-59" value="requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-13" target="arch-19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="668" y="582"/><mxPoint x="668" y="885"/></Array></mxGeometry></mxCell><mxCell id="arch-60" value="save / restore" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-14" target="arch-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="2 · Lesson flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow-1" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Lesson flow&lt;/b&gt;&lt;/font&gt; — the reducer decides, the hook acts, the server streams&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#666&quot;&gt;status machine (left) and one tutor turn (right)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="60" as="geometry"/></mxCell><mxCell id="flow-2" value="idle&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;UploadScreen&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;align=center;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="170" height="60" as="geometry"/></mxCell><mxCell id="flow-3" value="planning&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;POST /api/lessons/plan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;align=center;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="170" height="60" as="geometry"/></mxCell><mxCell id="flow-4" value="plan_error&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;Try again / Back&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;align=center;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="320" y="260" width="170" height="60" as="geometry"/></mxCell><mxCell id="flow-5" value="ready&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;lesson + chat&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;align=center;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="170" height="60" as="geometry"/></mxCell><mxCell id="flow-6" value="finished&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;&quot;Lesson complete&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;align=center;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="170" height="60" as="geometry"/></mxCell><mxCell id="flow-7" value="planning_started&lt;br&gt;(file + teacher prompt)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-2" target="flow-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-8" value="plan_ready&lt;br&gt;currentStepIndex = 0&lt;br&gt;pendingTurn = start_step" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-3" target="flow-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-9" value="plan_failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="flow-3" target="flow-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-10" value="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="flow-4" target="flow-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-11" value="last step complete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-5" target="flow-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-12" value="reset (New lesson / Back / Cancel) → idle from any state · ready and finished lessons are saved to sessionStorage and restored after a reload" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="460" height="60" as="geometry"/></mxCell><mxCell id="flow-13" value="&lt;b&gt;pendingTurn is set&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;start_step: after the plan, or after a step completes · reply: after student_message_sent&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="330" height="70" as="geometry"/></mxCell><mxCell id="flow-14" value="&lt;b&gt;useLesson effect → runTurn()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tutor_turn_started (empty tutor message, streaming) · one turn at a time (ref guard)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="330" height="70" as="geometry"/></mxCell><mxCell id="flow-15" value="&lt;b&gt;POST /api/lessons/turn&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;kind · plan outline · step index · &lt;b&gt;current step's passages&lt;/b&gt; · last 12 messages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="600" y="310" width="330" height="70" as="geometry"/></mxCell><mxCell id="flow-16" value="&lt;b&gt;Server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;openTutorStream() before the response starts (errors → JSON) · then SSE&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="310" width="300" height="70" as="geometry"/></mxCell><mxCell id="flow-17" value="&lt;b&gt;event: delta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tutor_delta → text grows on screen (META held back by metaParser)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="600" y="410" width="330" height="65" as="geometry"/></mxCell><mxCell id="flow-18" value="&lt;b&gt;event: meta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;{ stepComplete, sourceIds } → tutor_turn_finished · sources for &quot;View source&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="600" y="505" width="330" height="65" as="geometry"/></mxCell><mxCell id="flow-19" value="stepComplete?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="650" y="600" width="230" height="80" as="geometry"/></mxCell><mxCell id="flow-20" value="&lt;b&gt;next step&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;currentStepIndex + 1 · pendingTurn = start_step (tutor opens it)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="600" width="300" height="70" as="geometry"/></mxCell><mxCell id="flow-21" value="&lt;b&gt;was the last step&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;status = finished&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="700" width="300" height="55" as="geometry"/></mxCell><mxCell id="flow-22" value="&lt;b&gt;wait for the student&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Composer enabled · student_message_sent → pendingTurn = reply&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="600" y="730" width="330" height="70" as="geometry"/></mxCell><mxCell id="flow-23" value="&lt;b&gt;Stop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;abort → tutor_turn_stopped (partial text kept, &quot;Stopped&quot;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1010" y="410" width="300" height="60" as="geometry"/></mxCell><mxCell id="flow-24" value="&lt;b&gt;error / cut off&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tutor_turn_failed → &quot;Try again&quot; → tutor_turn_retried (same kind of turn again)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="500" width="300" height="70" as="geometry"/></mxCell><mxCell id="flow-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-13" target="flow-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-14" target="flow-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-27" value="request →&lt;br&gt;← SSE e